# Copy to .env.local (gitignored) and fill in from the Supabase dashboard: Project Settings -> API.
# Use the publishable (anon) key only. Never put the service-role key in the app or in this file.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable key>

# Seed script only (never commit the real value). Dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>
